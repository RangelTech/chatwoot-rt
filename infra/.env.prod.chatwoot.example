# Produção VPS (infra-04). Copiar para infra/.env.prod.chatwoot (fora do Git).
# Só web + worker leem este arquivo — NÃO compartilhar com a bridge (achado
# real em produção, 17/08/2026: DATABASE_URL/PORT vazando pro serviço errado
# via env_file único quebrou o boot 2 vezes — Rails prioriza DATABASE_URL
# sobre POSTGRES_* e escutava na porta da bridge por engano).

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true

# Simplificação desta migração (ver comentário no docker-compose.prod.yml):
# rede interna do Docker, não mais IP público + TLS de certificado próprio.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_prod
POSTGRES_USERNAME=chatwoot_app
POSTGRES_PASSWORD=
# Banco `chatwoot_prod` + role `chatwoot_app` JÁ EXISTEM no Postgres da VPS
# (achado em 17/08/2026: resquício de deploy anterior via Cloud Run, mesmo
# Postgres compartilhado — schema Rails já migrado, 12 accounts de QA/smoke
# test, nenhum cliente real). Senha resetada nesta sessão, valor em
# `personal-skills/secrets/agent-llm/chatwoot-db-password.txt`.

SECRET_KEY_BASE=
# A senha PRECISA estar URL-encoded aqui (`!`, `^` etc quebram o parser de
# URI do Ruby com "bad URI(is not URI?)"). `node -e "console.log(encodeURIComponent(pw))"`.
REDIS_URL=redis://:${REDIS_PASSWORD_URLENCODED}@redis:6379/1

FRONTEND_URL=https://chat.rangeltech.net
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=chatwoot
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://storage.rangeltech.net
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR
