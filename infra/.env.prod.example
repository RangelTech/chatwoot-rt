# Produção VPS (infra-04). Copiar para infra/.env.prod (fora do Git).
# Compartilhado pelos 3 serviços (web/worker/bridge) via env_file no compose —
# cada um só lê as variáveis que usa, sem problema em duplicar aqui.

# --- Chatwoot (web + worker) ---
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true

# Simplificação desta migração (ver comentário no docker-compose.prod.yml):
# rede interna do Docker, não mais IP público + TLS de certificado próprio.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_prod
POSTGRES_USERNAME=chatwoot_app
POSTGRES_PASSWORD=
# Pré-requisito operacional (não coberto por este arquivo): criar o banco
# `chatwoot_prod` e o usuário `chatwoot_app` no Postgres do vps_rt_infra antes
# do primeiro `up` — é o mesmo Postgres compartilhado, o Chatwoot não sobe um
# banco próprio.

SECRET_KEY_BASE=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

FRONTEND_URL=https://chat.rangeltech.net
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_BUCKET_NAME=chatwoot
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=https://storage.rangeltech.net
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR

# --- Bridge (chatwoot-bridge) ---
# production trava o boot sem ENCRYPTION_KEY (main.py) — proposital.
ENVIRONMENT=production
# Mesmo padrão de rede interna acima — bridge/app/config.py lê DATABASE_URL
# como URL única (diferente das vars separadas do Chatwoot).
DATABASE_URL=postgresql://chatwoot_bridge_app:REAL_PASSWORD@postgres:5432/chatwoot_bridge
ENCRYPTION_KEY=
BRIDGE_ADMIN_TOKEN=
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_BASE_URL=https://chat.rangeltech.net
AGENT_PLATFORM_URL=https://ia.rangeltech.net
BRIDGE_PUBLIC_URL=https://bridge.rangeltech.net
# AGENT_PLATFORM_API_KEY removida (17/08/2026) — era declarada mas nunca usada.
# A chamada real ao agent-platform usa `integration_key` por tenant, não uma
# chave de serviço global.
PORT=8100
