# Produção VPS (infra-04). Copiar para infra/.env.prod.bridge (fora do Git).
# Só a bridge lê este arquivo — separado do .env.prod.chatwoot de propósito
# (ver comentário lá: vazamento de DATABASE_URL/PORT entre serviços via
# arquivo único quebrou o boot do Chatwoot 2 vezes em produção).

# production trava o boot sem ENCRYPTION_KEY (main.py) — proposital.
ENVIRONMENT=production
# Role real chamada `bridge_app` (não `chatwoot_bridge_app` — nome corrigido
# em 17/08/2026 depois de achar o banco já existente com esse nome real).
# Banco `chatwoot_bridge` já existe, com dado real de QA (5 tenant_links,
# schema já migrado: 0001_bridge.sql, 0002_agent_bot_por_conta.sql).
DATABASE_URL=postgresql://bridge_app:REAL_PASSWORD@postgres:5432/chatwoot_bridge
ENCRYPTION_KEY=
BRIDGE_ADMIN_TOKEN=
# JÁ EXISTE um platform app "rangel-bridge" (id=1, criado 31/07/2026) com
# token recuperado do banco (Chatwoot guarda em texto puro em access_tokens).
# Valor em personal-skills/secrets/agent-llm/chatwoot-platform-token.txt —
# reaproveitar em vez de rodar bootstrap_platform.rb de novo (evita duplicar
# platform app).
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_BASE_URL=https://chat.rangeltech.net
AGENT_PLATFORM_URL=https://ia.rangeltech.net
BRIDGE_PUBLIC_URL=https://bridge.rangeltech.net
PORT=8100
