<section class="main-content__body">
  <hr/>
  <%= form_tag(provisional_password_super_admin_user_path(page.resource), method: :post, class: "form") do %>
    <p class="pb-3">Gera uma senha provisória (exibida uma única vez). A pessoa será obrigada a trocá-la no primeiro acesso.</p>
    <div class="form-actions"><%= submit_tag 'Gerar senha provisória' %></div>
  <% end %>
</section>
