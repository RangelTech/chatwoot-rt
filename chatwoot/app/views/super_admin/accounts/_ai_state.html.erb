<section class="main-content__body">
  <hr/>
  <p class="pb-3"><strong>IA desta empresa:</strong> <%= page.resource.ai_state %>
    <% if page.resource.ai_last_error.present? %><br><span class="text-sm"><%= page.resource.ai_last_error %></span><% end %>
  </p>
  <%= form_for([:reprovision, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
    <div class="form-actions"><%= f.submit 'Reprovisionar IA' %></div>
  <% end %>
</section>
<section class="main-content__body">
  <hr/>
  <%= form_tag(create_admin_super_admin_account_path(page.resource), method: :post, class: "form") do %>
    <p class="pb-3">Cria o administrador da empresa com uma senha provisória, exibida uma única vez.</p>
    <div class="field-unit"><div class="field-unit__label"><%= label_tag :name, 'Nome' %></div>
      <div class="field-unit__field"><%= text_field_tag :name %></div></div>
    <div class="field-unit"><div class="field-unit__label"><%= label_tag :email, 'E-mail' %></div>
      <div class="field-unit__field"><%= email_field_tag :email %></div></div>
    <div class="form-actions"><%= submit_tag 'Criar administrador' %></div>
  <% end %>
</section>
<section class="main-content__body">
  <hr/>
  <% ai_rec = Rt::AiAccount.find_by(account_id: page.resource.id) %>
  <%= form_tag(update_ai_plan_super_admin_account_path(page.resource), method: :post, class: "form") do %>
    <p class="pb-3"><strong>Plano do cliente</strong> (define o que a empresa pode usar)</p>
    <div class="field-unit"><div class="field-unit__label"><%= label_tag :plan, 'Plano' %></div>
      <div class="field-unit__field"><%= select_tag :plan, options_for_select(Rt::AiAccount::PLANS.map { |k, v| [v['name'], k] }, ai_rec&.plan || 'nova') %></div></div>
    <div class="form-actions"><%= submit_tag 'Salvar plano' %></div>
  <% end %>
</section>
<section class="main-content__body">
  <hr/>
  <% ai_flags = Rt::AiAccount.find_by(account_id: page.resource.id)&.effective_flags || Rt::AiAccount::DEFAULT_FLAGS %>
  <%= form_tag(update_ai_flags_super_admin_account_path(page.resource), method: :post, class: "form") do %>
    <p class="pb-3"><strong>Flags de IA desta empresa</strong></p>
    <% Rt::AiAccount::DEFAULT_FLAGS.each_key do |key| %>
      <div class="field-unit"><div class="field-unit__label"><%= label_tag "ai_flags_#{key}", key %></div>
        <div class="field-unit__field"><%= hidden_field_tag "ai_flags[#{key}]", '0', id: nil %>
          <%= check_box_tag "ai_flags[#{key}]", '1', ai_flags[key] == true, id: "ai_flags_#{key}" %></div></div>
    <% end %>
    <div class="form-actions"><%= submit_tag 'Salvar flags de IA' %></div>
  <% end %>
</section>
